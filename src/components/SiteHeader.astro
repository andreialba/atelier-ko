---
import { Image } from "astro:assets";
import CartDrawer from "@/components/CartDrawer.astro";
import { siteConfig } from "@/config/site";
import { formatPrice, getProducts, requireProduct } from "@/data/products";

interface Props {
  /** Current pathname, used to mark the active nav item. */
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const isActive = (href: string) => (href === "/" ? currentPath === "/" : currentPath.startsWith(href));

const navItems = siteConfig.navigation;
const featuredProduct = requireProduct(await getProducts(), siteConfig.featured.mobileMenu);
const cartIndex = String(navItems.length + 1).padStart(2, "0");
---

<header class="site-header sticky top-0 z-50">
  <nav class="shell flex h-[4.5rem] items-center justify-between gap-6" aria-label="Main">
    <a
      href="/"
      class="-m-2 p-2 text-[0.9375rem] font-semibold uppercase tracking-[-0.01em] transition-colors hover:text-accent"
      aria-label={`${siteConfig.name}, home`}
    >
      {siteConfig.name}
    </a>

    <ul class="hidden items-center gap-9 md:flex">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={["nav-link link-mono", isActive(item.href) && "is-current"]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1">
      <a
        href="/cart"
        data-cart-toggle
        data-cart-label
        aria-label="Cart, 0 items"
        aria-expanded="false"
        aria-controls="cart-drawer-panel"
        class="link-mono -m-2 inline-flex items-center gap-2 p-2 transition-colors hover:text-accent"
      >
        <span class="hidden sm:inline">Cart</span>
        <span class="mono text-[0.6875rem]" data-cart-count>00</span>
      </a>
      <button
        type="button"
        class="-mr-2 inline-flex size-10 items-center justify-center transition-colors hover:text-accent md:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-mobile-menu-open
      >
        <span class="sr-only">Open menu</span>
        <span class="flex w-[1.125rem] flex-col gap-[5px]" aria-hidden="true">
          <span class="h-px w-full bg-current"></span>
          <span class="h-px w-full bg-current"></span>
        </span>
      </button>
    </div>
  </nav>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-[60] h-dvh bg-canvas md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
  data-mobile-menu
  hidden
>
  <div class="flex h-full flex-col px-[var(--gutter)] pb-8 pt-0">
    <div class="flex h-[4.5rem] shrink-0 items-center justify-between">
      <span class="text-[0.9375rem] font-semibold uppercase tracking-[-0.01em]">Menu</span>
      <button
        type="button"
        class="-mr-2 inline-flex size-10 items-center justify-center transition-colors hover:text-accent"
        data-mobile-menu-close
      >
        <span class="sr-only">Close menu</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
          <path d="M5 5l14 14"></path>
          <path d="M19 5L5 19"></path>
        </svg>
      </button>
    </div>

    <ul class="mt-6 border-t border-line">
      {
        navItems.map((item, index) => (
          <li class="menu-item border-b border-line" style={`--i:${index}`}>
            <a
              href={item.href}
              class:list={[
                "flex items-baseline gap-4 py-5 transition-colors hover:text-accent",
                !isActive(item.href) && "text-muted",
              ]}
              aria-current={isActive(item.href) ? "page" : undefined}
              data-mobile-menu-link
            >
              <span class="mono text-[0.6875rem] text-accent">{String(index + 1).padStart(2, "0")}</span>
              <span class="type-h3">{item.label}</span>
            </a>
          </li>
        ))
      }
      <li class="menu-item border-b border-line" style={`--i:${navItems.length}`}>
        <a
          href="/cart"
          data-cart-label
          aria-label="Cart, 0 items"
          class="flex items-baseline gap-4 py-5 text-muted transition-colors hover:text-accent"
          data-mobile-menu-link
        >
          <span class="mono text-[0.6875rem] text-accent">{cartIndex}</span>
          <span class="type-h3">Cart</span>
          <span class="mono ml-auto self-center text-[0.6875rem]" data-cart-count>00</span>
        </a>
      </li>
    </ul>

    <a
      href={`/products/${featuredProduct.slug}`}
      class="menu-item group mt-auto block pt-8"
      style={`--i:${navItems.length + 1}`}
      data-mobile-menu-link
    >
      <div class="overflow-hidden bg-surface">
        <Image
          src={featuredProduct.images[0]}
          alt={`${featuredProduct.name} — ${featuredProduct.shortDescription}`}
          width={900}
          height={560}
          format="webp"
          loading="lazy"
          class="aspect-[16/10] max-h-[28dvh] w-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-[1.04]"
        />
      </div>
      <div class="mt-3 flex items-baseline justify-between gap-4">
        <p class="label">In the workshop — {featuredProduct.name}</p>
        <p class="mono text-[0.6875rem]">{formatPrice(featuredProduct.price)}</p>
      </div>
    </a>
  </div>
</div>

<CartDrawer />

<style>
  .nav-link {
    display: inline-block;
    color: var(--muted);
    transition: color 240ms ease;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link.is-current {
    color: var(--ink);
  }

  /* Active route is marked with an accent rule, not colour alone. */
  .nav-link.is-current::after {
    content: "";
    display: block;
    height: 1px;
    margin-top: 5px;
    background: var(--accent);
  }

  [data-mobile-menu][hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-mobile-menu]:not([hidden]) {
      animation: menu-in 320ms var(--ease-out-expo) both;
    }

    [data-mobile-menu]:not([hidden]) .menu-item {
      animation: menu-item-in 620ms var(--ease-out-expo) both;
      animation-delay: calc(120ms + var(--i, 0) * 55ms);
    }

    @keyframes menu-in {
      from {
        opacity: 0;
        clip-path: inset(0 0 100% 0);
      }
    }

    @keyframes menu-item-in {
      from {
        opacity: 0;
        transform: translate3d(0, 1.25rem, 0);
      }
    }
  }
</style>

<script is:inline>
  (() => {
    const menu = document.querySelector("[data-mobile-menu]");
    const openButton = document.querySelector("[data-mobile-menu-open]");
    const closeButton = document.querySelector("[data-mobile-menu-close]");

    if (!menu || !openButton || !closeButton) return;

    const focusableSelector = "a[href],button:not([disabled]),input:not([disabled]),[tabindex]:not([tabindex='-1'])";
    let lastFocused = null;

    function getFocusable() {
      return Array.from(menu.querySelectorAll(focusableSelector)).filter((node) => node.offsetParent !== null);
    }

    function openMenu() {
      lastFocused = document.activeElement;
      menu.hidden = false;
      openButton.setAttribute("aria-expanded", "true");
      document.documentElement.style.overflow = "hidden";
      closeButton.focus({ preventScroll: true });
    }

    function closeMenu({ restoreFocus = true } = {}) {
      menu.hidden = true;
      openButton.setAttribute("aria-expanded", "false");
      document.documentElement.style.overflow = "";
      if (restoreFocus && lastFocused) lastFocused.focus({ preventScroll: true });
    }

    openButton.addEventListener("click", openMenu);
    closeButton.addEventListener("click", () => closeMenu());

    menu.querySelectorAll("[data-mobile-menu-link]").forEach((link) => {
      link.addEventListener("click", () => closeMenu({ restoreFocus: false }));
    });

    document.addEventListener("keydown", (event) => {
      if (menu.hidden) return;

      if (event.key === "Escape") {
        event.preventDefault();
        closeMenu();
        return;
      }

      if (event.key !== "Tab") return;

      const focusable = getFocusable();
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (!first || !last) return;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    window.addEventListener("resize", () => {
      if (!menu.hidden && window.matchMedia("(min-width: 768px)").matches) {
        closeMenu({ restoreFocus: false });
      }
    });
  })();
</script>
