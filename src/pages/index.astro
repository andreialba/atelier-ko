---
import { Image } from "astro:assets";
import ProductCard from "@/components/ProductCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import heroImg from "@/assets/atelier-hero.jpg";
import { siteConfig } from "@/config/site";
import { formatPrice, getProducts, requireProduct } from "@/data/products";

const products = await getProducts();
const featured = siteConfig.featured.homepageGrid.map((slug) => requireProduct(products, slug));
const solo = requireProduct(products, siteConfig.featured.homepageSolo);

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href;

const facts = [
  { value: "2018", label: "Founded" },
  { value: siteConfig.location.region, label: "Sweden" },
  { value: String(products.length).padStart(2, "0"), label: "Pieces" },
  { value: "03", label: "Timbers" },
];

const materials = [
  {
    name: "European Oak",
    tag: "Quiet · structural",
    copy: "A single grade of slow-grown oak from managed forests in southern Sweden. Quarter-sawn for stability.",
  },
  {
    name: "Curved Ash",
    tag: "Resilient · sprung",
    copy: "A small reserve from the south coast, steam-bent over custom forms. Used only where the curve earns it.",
  },
  {
    name: "American Walnut",
    tag: "Warm · figured",
    copy: "Bought in single planks from a family mill in Pennsylvania. The grain decides the piece, not the reverse.",
  },
];

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteConfig.name,
  url: siteUrl,
  slogan: siteConfig.tagline,
  email: siteConfig.email,
  address: {
    "@type": "PostalAddress",
    addressRegion: siteConfig.location.region,
    addressCountry: siteConfig.location.country,
  },
};
---

<BaseLayout
  title={`${siteConfig.name} — ${siteConfig.tagline}`}
  description="A small catalogue of seating, tables and storage. Solid oak, ash and walnut, hand-built to order in Småland, Sweden."
>
  <main id="main-content">
    {/* ---------------------------------------------------------------- Hero */}
    <section class="shell grid items-center gap-x-12 gap-y-10 pb-4 pt-8 md:grid-cols-12 md:pb-10 md:pt-12">
      <div class="hero-in md:col-span-5">
        <h1 class="type-hero">Hand-carved pieces from the northern woods</h1>
        <p class="type-lead mt-7 max-w-[42ch]">
          A small, slow catalogue of seating, tables and storage — solid oak, ash and walnut, shaped by hand and
          built to outlast the room they were made for.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/catalog" class="btn btn-primary">Browse the catalogue</a>
          <a href="/about" class="btn btn-outline">The workshop</a>
        </div>
      </div>

      <figure class="hero-in md:col-span-7" style="--reveal-delay:120ms">
        <div class="overflow-hidden bg-surface">
          <Image
            src={heroImg}
            alt="Hand-carved sculptural walnut lounge chair in a sunlit atelier"
            width={1600}
            height={1400}
            format="webp"
            loading="eager"
            decoding="sync"
            class="parallax aspect-[4/3] w-full object-cover object-right md:aspect-[8/7]"
          />
        </div>
        <figcaption class="mono mt-3 flex justify-between gap-4 text-[0.625rem] uppercase tracking-[0.05em] text-muted">
          <span>No. 04 — Arvid Lounge</span>
          <span>Solid walnut · 2025</span>
        </figcaption>
      </figure>
    </section>

    {/* Spec band */}
    <div class="mt-14 border-y border-line md:mt-20">
      <dl class="shell grid grid-cols-2 md:grid-cols-4">
        {
          facts.map((fact, index) => (
            <div class="fact" data-reveal style={`--reveal-delay:${index * 70}ms`}>
              <dt class="label">{fact.label}</dt>
              <dd class="mt-2.5 text-2xl font-medium tracking-[-0.03em] md:text-3xl">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    {/* --------------------------------------------------- Currently in build */}
    <section class="shell mt-24 md:mt-36">
      <div class="rule" data-reveal="line"></div>
      <div class="mt-8 flex flex-wrap items-end justify-between gap-x-8 gap-y-4" data-reveal>
        <h2 class="type-h2 max-w-[14ch]">A few pieces, close to ready</h2>
        <a href="/catalog" class="link link-mono pb-1.5 text-muted">All six pieces</a>
      </div>

      <div class="mt-12 grid gap-x-8 gap-y-14 md:mt-14 md:grid-cols-3">
        {
          featured.map((product, index) => (
            <ProductCard product={product} index={index} revealDelay={index * 110} />
          ))
        }
      </div>
    </section>

    {/* ------------------------------------------------------------- The solo */}
    <section class="mt-24 md:mt-36">
      <div class="shell grid items-center gap-10 md:grid-cols-12 md:gap-12">
        <div class="md:col-span-7 lg:col-span-8">
          <a
            href={`/products/${solo.slug}`}
            class="group block overflow-hidden bg-surface"
            data-reveal="mask"
            aria-label={`${solo.name} — ${solo.shortDescription}`}
          >
            {/* Wrapper carries the unmask clip so the image keeps its own
                hover transition — see the mask notes in src/styles.css. */}
            <div>
              <Image
                src={solo.images[0]}
                alt=""
                width={1600}
                height={1100}
                loading="lazy"
                format="webp"
                class="aspect-[5/4] w-full object-cover transition-transform duration-[1100ms] ease-out group-hover:scale-[1.04] md:aspect-[16/11]"
              />
            </div>
          </a>
        </div>

        <div class="md:col-span-5 lg:col-span-4" data-reveal style="--reveal-delay:140ms">
          <h2 class="type-h2">One plank, no hardware</h2>
          <p class="type-body mt-6 max-w-[44ch]">{solo.description}</p>

          <dl class="mono mt-9 border-t border-line text-[0.8125rem]">
            {
              [
                ["Dimensions", solo.dimensions],
                ["Finish", solo.finish],
                ["Lead time", solo.leadTime],
                ["From", formatPrice(solo.price)],
              ].map(([term, value]) => (
                <div class="flex justify-between gap-6 border-b border-line py-3">
                  <dt class="text-muted">{term}</dt>
                  <dd class="text-right">{value}</dd>
                </div>
              ))
            }
          </dl>

          <a href={`/products/${solo.slug}`} class="btn btn-primary mt-9">See the piece</a>
        </div>
      </div>
    </section>

    {/* ----------------------------------------------------------- Materials */}
    <section class="shell mt-24 md:mt-36">
      <div class="rule" data-reveal="line"></div>
      <h2 class="type-h2 mt-8 max-w-[18ch]" data-reveal>We've spent years learning three timbers</h2>

      <div class="mt-12 grid gap-x-8 gap-y-12 md:grid-cols-3">
        {
          materials.map((material, index) => (
            <div class="border-t border-line pt-6" data-reveal style={`--reveal-delay:${index * 110}ms`}>
              <h3 class="type-h3">{material.name}</h3>
              <p class="label mt-3">{material.tag}</p>
              <p class="type-body mt-4 text-[0.9375rem]">{material.copy}</p>
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
</BaseLayout>
